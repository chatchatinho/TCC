# Copie este arquivo para .env e preencha os valores reais. Nunca commite o .env real.

# String de conexão do PostgreSQL (formato: postgresql://usuario:senha@host:porta/banco)
DATABASE_URL="postgresql://tcc_dev:CHANGE_ME@localhost:5432/tcc_dev"

# Porta em que a API vai rodar
API_PORT=3000

# Segredo usado para assinar os JWTs de sessão do usuário — gere um valor aleatório longo
JWT_SECRET="CHANGE_ME"

# Origem permitida para CORS (URL do frontend)
CORS_ORIGIN="http://localhost:5173"

# URL do frontend usada para montar o link de redefinição de senha enviado por e-mail
FRONTEND_URL="http://localhost:5173"

# SMTP para o envio de e-mails (recuperação de senha). Deixe SMTP_HOST em branco para
# rodar em MODO SIMULAÇÃO: nenhum e-mail é enviado de verdade — o link de redefinição
# é só impresso no console do backend, suficiente para demonstrar e testar o fluxo
# completo sem depender de credenciais nem de acesso à internet.
# Para enviar e-mails de verdade no futuro, preencha estas variáveis — exemplo com
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
# SMTP_USER=seu-email@gmail.com, SMTP_PASS=senha-de-app-do-gmail (não a senha normal).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ThermoSense <no-reply@thermosense.local>"
