# Copie este arquivo para .env e preencha os valores reais. Nunca commite o .env real.

# String de conexão do PostgreSQL (formato: postgresql://usuario:senha@host:porta/banco)
DATABASE_URL="postgresql://tcc_dev:CHANGE_ME@localhost:5432/tcc_dev"

# Porta em que a API vai rodar
API_PORT=3000

# Segredo usado para assinar os JWTs de sessão do usuário — gere um valor aleatório longo
JWT_SECRET="CHANGE_ME"

# Origem permitida para CORS (URL do frontend)
CORS_ORIGIN="http://localhost:5173"
