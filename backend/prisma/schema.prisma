// Schema do banco de dados do TCC — Sistema de Monitoramento de Temperatura e Umidade
// Decisões de modelagem completas em docs/01-arquitetura-e-decisoes.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(uuid())
  fullName               String    @map("full_name")
  // E-mail é normalizado para minúsculas na camada de aplicação antes de gravar/consultar,
  // já que o Prisma não expõe o tipo `citext` nativamente.
  email                  String    @unique
  passwordHash           String    @map("password_hash")
  birthDate              DateTime  @map("birth_date") @db.Date
  // Foto de perfil opcional, guardada como data URL (base64) — evita depender de
  // armazenamento de arquivos/S3 para um recurso opcional num projeto de TCC. Tamanho
  // limitado na validação do backend (ver users.validation.js).
  avatarData             String?   @map("avatar_data")
  // Par usado no fluxo de "esqueci minha senha": só o HASH do token fica no banco
  // (mesmo princípio do token de dispositivo) — o token em texto puro só existe no link
  // enviado por e-mail e nunca é persistido. Expira em 1h (ver auth.service.js).
  passwordResetTokenHash String?   @map("password_reset_token_hash")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at") @db.Timestamptz(3)
  // Atualizado a cada login bem-sucedido; o valor exibido ao usuário é o de ANTES dessa
  // atualização (o login anterior), não o da sessão que ele acabou de abrir — mesmo
  // princípio de "último acesso" usado por Gmail/GitHub (ver auth.service.js#login).
  lastLoginAt            DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  devices  Device[]
  alerts   Alert[]

  @@map("users")
}

model Device {
  id               String    @id @default(uuid())
  deviceIdentifier String    @unique @map("device_identifier")
  name             String
  // Hash (bcrypt) do token do dispositivo — nunca armazenado em texto puro.
  deviceSecretHash String    @map("device_secret_hash")
  userId           String    @map("user_id")
  active           Boolean   @default(true)
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz(3)
  // Atualizado SÓ por leituras vindas do endpoint autenticado por dispositivo (nunca
  // pelo endpoint de simulação) — é o sinal que o frontend usa para saber se um ESP32
  // físico está ativo agora e, com isso, desligar a simulação automática do dashboard.
  lastRealMeasurementAt DateTime? @map("last_real_measurement_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  measurements Measurement[]
  alerts       Alert[]
  settings     Setting?
  pump         Pump?

  @@index([userId])
  @@map("devices")
}

model Measurement {
  id          String   @id @default(uuid())
  deviceId    String   @map("device_id")
  temperature Decimal  @db.Decimal(5, 2)
  humidity    Decimal  @db.Decimal(5, 2)
  // Sensor de umidade do solo é opcional — nem todo dispositivo tem um instalado (ex.:
  // um sensor só de ambiente, sem irrigação associada) — por isso fica nullable, ao
  // contrário de temperature/humidity (do ar), que todo dispositivo sempre envia.
  soilMoisture Decimal? @map("soil_moisture") @db.Decimal(5, 2)
  measuredAt  DateTime @map("measured_at") @db.Timestamptz(3)
  receivedAt  DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  device Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  alerts Alert[]

  // Índice essencial para consultas de histórico/gráfico (filtro por dispositivo + período).
  @@index([deviceId, measuredAt(sort: Desc)])
  @@map("measurements")
}

// Cada dispositivo tem sua própria configuração de limites — dois sensores do mesmo
// usuário podem monitorar ambientes bem diferentes (ex.: uma estufa e uma geladeira),
// então não faz sentido uma única faixa "universal" valer para todos os dispositivos.
model Setting {
  id                   String   @id @default(uuid())
  deviceId             String   @unique @map("device_id")
  idealTemperature     Decimal  @default(25) @map("ideal_temperature") @db.Decimal(5, 2)
  temperatureTolerance Decimal  @default(2) @map("temperature_tolerance") @db.Decimal(5, 2)
  // Taxa mínima/máxima de temperatura, opcionais: quando definidas, substituem o
  // cálculo automático (ideal ± tolerância) daquele lado da faixa — para quem quer um
  // limite assimétrico ou mais apertado do que a tolerância simétrica permite. Ideal e
  // tolerância continuam obrigatórios mesmo quando as duas taxas estão definidas.
  temperatureMin       Decimal? @map("temperature_min") @db.Decimal(5, 2)
  temperatureMax       Decimal? @map("temperature_max") @db.Decimal(5, 2)
  idealHumidity        Decimal  @default(60) @map("ideal_humidity") @db.Decimal(5, 2)
  humidityTolerance    Decimal  @default(10) @map("humidity_tolerance") @db.Decimal(5, 2)
  humidityMin          Decimal? @map("humidity_min") @db.Decimal(5, 2)
  humidityMax          Decimal? @map("humidity_max") @db.Decimal(5, 2)
  // Desligam a geração de notificações/alertas daquela variável especificamente (o
  // usuário pode não se importar com umidade, por exemplo) — os cards de status no
  // dashboard/histórico continuam mostrando normal/fora do limite normalmente, só o
  // motor de alertas (evaluateMeasurement) para de abrir eventos para a variável.
  // Umidade do solo (sensor separado do DHT11, usado pela irrigação automática — ver
  // model Pump). Mesmo padrão de ideal/tolerância/mín-máx/notificação das outras duas
  // variáveis, mas independente delas: uma leitura sem sensor de solo (soilMoisture
  // nulo) simplesmente não é avaliada contra esses limites.
  idealSoilMoisture     Decimal  @default(40) @map("ideal_soil_moisture") @db.Decimal(5, 2)
  soilMoistureTolerance Decimal  @default(15) @map("soil_moisture_tolerance") @db.Decimal(5, 2)
  soilMoistureMin       Decimal? @map("soil_moisture_min") @db.Decimal(5, 2)
  soilMoistureMax       Decimal? @map("soil_moisture_max") @db.Decimal(5, 2)
  notifySoilMoisture    Boolean  @default(true) @map("notify_soil_moisture")
  notifyTemperature    Boolean  @default(true) @map("notify_temperature")
  notifyHumidity       Boolean  @default(true) @map("notify_humidity")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("settings")
}

enum AlertVariable {
  temperature
  humidity
  soil_moisture
}

enum AlertDirection {
  above_max
  below_min
}

enum AlertStatus {
  active
  resolved
}

model Alert {
  id                      String         @id @default(uuid())
  userId                  String         @map("user_id")
  deviceId                String         @map("device_id")
  variable                AlertVariable
  direction               AlertDirection
  triggeringMeasurementId String?        @map("triggering_measurement_id")
  peakValue               Decimal        @map("peak_value") @db.Decimal(5, 2)
  limitMin                Decimal        @map("limit_min") @db.Decimal(5, 2)
  limitMax                Decimal        @map("limit_max") @db.Decimal(5, 2)
  startedAt               DateTime       @map("started_at") @db.Timestamptz(3)
  endedAt                 DateTime?      @map("ended_at") @db.Timestamptz(3)
  status                  AlertStatus    @default(active)
  readAt                  DateTime?      @map("read_at") @db.Timestamptz(3)
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  device                Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  triggeringMeasurement Measurement? @relation(fields: [triggeringMeasurementId], references: [id], onDelete: SetNull)

  // Usado para achar rapidamente o alerta ativo de um dispositivo/variável e para
  // contar alertas não lidos de um usuário desde o último acesso.
  @@index([userId, status])
  @@index([deviceId, status])
  @@map("alerts")
}

// automatic: liga o relé sozinha quando a umidade do solo fica abaixo de
// moistureThreshold por belowThresholdMinutes seguidos.
// notify_only: nunca liga sozinha — só o motor de alertas (Setting.notifySoilMoisture)
// notifica o valor fora do limite; o acionamento continua possível manualmente.
// manual: o estado da bomba só muda por comando explícito do usuário.
enum PumpMode {
  automatic
  notify_only
  manual
}

// Bomba d'água interligada ao sensor de umidade do solo do dispositivo (1:1, mesmo
// padrão do Setting — cada dispositivo tem sua própria bomba/regra de irrigação).
model Pump {
  id       String   @id @default(uuid())
  deviceId String   @unique @map("device_id")
  mode     PumpMode @default(notify_only)
  // Umidade do solo (%) abaixo da qual o dispositivo é considerado "seco" — mesmo
  // valor usado tanto para decidir ligar a bomba (modo automatic) quanto só para
  // contar o tempo decorrido nos outros modos (exibido na tela, sem acionar o relé).
  moistureThreshold     Decimal   @default(30) @map("moisture_threshold") @db.Decimal(5, 2)
  belowThresholdMinutes Int       @default(30) @map("below_threshold_minutes")
  // Estado atual do relé — refletido pelo motor de avaliação (evaluateMeasurement) em
  // modo automatic, ou diretamente pelo endpoint de controle manual nos outros modos.
  isOn       Boolean   @default(false) @map("is_on")
  turnedOnAt DateTime? @map("turned_on_at") @db.Timestamptz(3)
  // Desde quando a leitura mais recente está continuamente abaixo do limite — nulo
  // quando a última leitura estava normal. Zerado assim que uma leitura volta a ficar
  // dentro do limite (o "período estipulado" é sempre contado a partir da streak atual,
  // nunca acumulado entre janelas separadas de seca).
  belowThresholdSince DateTime? @map("below_threshold_since") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("pumps")
}
